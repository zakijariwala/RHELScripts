#!/bin/bash
#==============================================================================
# pre-commit  -  run tools/check-all.sh on the STAGED tree; any failure
#                blocks the commit.
#
# Turn it on once per session:  git config core.hooksPath .githooks
# Never bypass it with --no-verify.
#==============================================================================
set -o pipefail
ROOT="$(git rev-parse --show-toplevel)" || exit 1
cd "$ROOT" || exit 1
STAGED=$(mktemp -d) || exit 1
trap 'rm -rf "$STAGED"' EXIT

# Export exactly what the commit will contain, then check that copy.
git checkout-index -a --prefix="$STAGED/" || exit 1
if ! bash "$STAGED/tools/check-all.sh"; then
    echo "pre-commit: BLOCKED. Fix the failures above, git add, commit again."
    exit 1
fi
