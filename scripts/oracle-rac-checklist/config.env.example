# config.env.example  -  settings for checklist.sh v2.1
#
# HOW TO USE
#   1. Copy this file to config.env in the same folder as checklist.sh:
#        cp config.env.example config.env
#   2. Replace every CHANGE_ME_ value. The comment above each line says what
#      the value is and how to find it.
#   3. Any line you delete falls back to the built-in default in
#      checklist.sh. The defaults are the same numbers you see here.
#
# RULES (checklist.sh refuses to run, exit code 64, if you break one)
#   - One KEY=value per line. No spaces around "=".
#   - Wrap a value in double quotes when it holds spaces or single quotes.
#   - A comment may follow a value: KEY=value  # comment
#   - No $(...), no `...`, no "source", no other shell code. checklist.sh
#     reads this file as plain data and checks every value.
#   - Only the keys below exist. A misspelt key is an error.
#
# config.env holds real host names. Never commit it: .gitignore blocks it.
# Owner oracle, mode 600:  chmod 600 config.env

#============================== HOSTS ==========================================

# Node 2 of the RAC cluster: IP address or host name that node 1 reaches.
# Find it on node 1:  olsnodes -n   (as oracle; lists both nodes)
#   or ask the DBA team.
NODE2_HOST=CHANGE_ME_NODE2_IP

# ssh port on node 2. 22 unless your site moved ssh.
# Find it on node 2:  sudo grep -i '^Port' /etc/ssh/sshd_config  (no line = 22)
NODE2_PORT=22

# The host that runs GoldenGate (where gg2.sh lives). Ask the DBA team.
# Leave as is and set CHECK_GG=0 below if the cluster has no GoldenGate.
GG_HOST=CHANGE_ME_GG_IP

# ssh port on the GoldenGate host. 22 unless your site moved ssh.
GG_PORT=22

#============================== TOGGLES ========================================

# 1 = check GoldenGate through gg2.sh on GG_HOST. 0 = skip it.
# Use 0 on clusters with no GoldenGate (pre-production, usually).
CHECK_GG=1

# 1 = check Data Guard sync to the standby. 0 = skip it.
# Use 0 when the database has no standby. Find out (as oracle, on node 1):
#   sqlplus -s / as sysdba <<< "SELECT dest_id FROM v\$archive_dest WHERE target='STANDBY' AND status<>'INACTIVE';"
#   "no rows selected" = no standby = use 0.
CHECK_DG=1

# 1 = check RMAN backup age. 0 = skip it.
# Use 0 when backups run on the standby, or when this database has no
# backups (pre-production). Ask the DBA or backup team.
CHECK_RMAN=1

# 1 = count ORA- errors in the alert log. 0 = skip it.
# Use 0 if a test run takes longer than 2 minutes (this query can be slow).
CHECK_ALERTLOG=1

#============================== TIMEOUTS (seconds) =============================

# Longest wait for one ssh call (node 2, GoldenGate host).
SSH_TIMEOUT=60

# Longest wait for all database queries together.
SQL_TIMEOUT=300

# Longest wait for "crsctl stat res -t".
CRS_TIMEOUT=60

# Longest wait for activesession.sh.
ACTIVESESSION_TIMEOUT=120

#============================== PATHS ==========================================

# Folder on node 1 that holds activesession.sh, and on GG_HOST that holds
# gg2.sh. Check:  ls /home/oracle/scripts   (as oracle)
SCRIPTS_DIR=/home/oracle/scripts

# Full path of gg2.sh on GG_HOST. Blank = $SCRIPTS_DIR/gg2.sh
GG_SCRIPT=

# Full path of activesession.sh on node 1. Blank = $SCRIPTS_DIR/activesession.sh
ACTIVESESSION_SCRIPT=

# File another job writes with the sftp.log size. Check:  ls -l /home/oracle/sftp_output
SFTP_FILE=/home/oracle/sftp_output

# File another job writes with the app server reachability counts.
# Check:  ls -l /home/oracle/server_checklist
SERVER_FILE=/home/oracle/server_checklist

# Grid Infrastructure home, the folder that holds bin/crsctl.
# Blank = read from /etc/oracle/olr.loc automatically. Check:
#   grep crs_home /etc/oracle/olr.loc
GRID_HOME=

#============================== HISTORY LOG ====================================

# 1 = append every run's results to a daily log file. 0 = no log.
# --no-history on the command line overrides this for one run.
WRITE_HISTORY=1

# Folder for the daily log files (checklist_YYYYMMDD.log). Created if missing.
LOG_DIR=/home/oracle/checklist_history

# Log files older than this many days are deleted at the end of each run.
LOG_RETENTION_DAYS=30

#============================== MAIL ===========================================
# Used only with --mail or --mail-if-issues. README.md, "Mail setup", has the
# steps to test the mail path first.

# Recipients, comma separated. Example: dba-team@example.com,ops@example.com
MAIL_TO=

# Copy recipients, comma separated. Blank = none.
MAIL_CC=

# Sender address. Must be an address the mail relay accepts from this server.
# Ask the mail team. Blank = the oracle user's default address.
MAIL_FROM=

# Environment name in the mail subject:
#   [WARN] Monitoring Checklist | <SUBJECT_TAG> | 02-10-2026 | 19:30
# Letters, digits, spaces, dots, dashes. Example: PROD or PRE PROD
SUBJECT_TAG=CHANGE_ME_ENV

#============================== DATABASE =======================================

# The application's schema (database user), in capitals, as Oracle stores it.
# Find it: ask the application team, or as oracle on node 1:
#   sqlplus -s / as sysdba <<< "SELECT username FROM dba_users WHERE oracle_maintained='N';"
APP_USER=CHANGE_ME_APP_SCHEMA

# Number of instances that must be OPEN. 2 for a two-node RAC.
# Check: srvctl status database -d <DB_UNIQUE_NAME>   (as oracle)
EXPECTED_INSTANCES=2

# Users ignored by the long-running call check, each in single quotes,
# comma separated. Replace GGADMIN with your GoldenGate database user; its
# sessions stay ACTIVE all the time. Ask the DBA team for the name.
LONG_QUERY_EXCLUDE="'SYS','SYSTEM','GGADMIN'"

#============================== THRESHOLDS =====================================
# A value above WARN is WARN; above CRIT is CRIT. "v1" marks a number kept
# from the first script so results stay comparable during rollout.
# RUNBOOK.md explains every row these feed.

# CPU busy %, average of three 1-second samples (v1: 60)
CPU_WARN=60
CPU_CRIT=85

# Memory used %, counting cache the kernel can free as free (v1: 75)
MEM_WARN=75
MEM_CRIT=90

# Swap used %
SWAP_WARN=10
SWAP_CRIT=30

# 1-minute load average divided by CPU cores
LOAD_WARN=1.0
LOAD_CRIT=2.0

# Filesystem used %, per mount point, both nodes
FS_WARN=80
FS_CRIT=90

# TEMP tablespace used % of its maximum size (v1: 75 / 90)
TEMP_WARN=75
TEMP_CRIT=90

# Permanent tablespace used % of its maximum size, autoextend included
TS_WARN=85
TS_CRIT=95

# Fast Recovery Area used %, after subtracting space Oracle can reclaim
FRA_WARN=80
FRA_CRIT=90

# ASM diskgroup used %
ASM_WARN=80
ASM_CRIT=90

# processes and sessions in use, % of their database limits
LIMIT_WARN=80
LIMIT_CRIT=90

# APP_USER sessions per instance: ACTIVE above this = WARN (v1: 18)
ACTIVE_MAX=18

# APP_USER sessions per instance: INACTIVE above this = WARN (v1: 1000)
INACTIVE_MAX=1000

# Data Guard: archive logs the standby is behind, per thread (v1: 10 / 100)
GAP_WARN=10
GAP_CRIT=100

# Data Guard: minutes the standby is behind (counted only when the gap is
# above 0, so a quiet thread raises no alarm)
LAG_WARN_MIN=15
LAG_CRIT_MIN=60

# An instance started less than this many days ago = WARN (spots restarts)
RESTART_WARN_DAYS=1

# A session blocked by another for longer than this many seconds = WARN
BLOCK_SECS=300

# A user call running longer than this many seconds = WARN
LONG_QUERY_SECS=1800

# RMAN: hours since the last good full/incremental backup before CRIT
DB_BACKUP_MAX_HRS=26

# RMAN: hours since the last good archivelog backup before WARN
ARCH_BACKUP_MAX_HRS=6

# Alert log: how many hours back to count ORA- errors
ALERT_WINDOW_HRS=4

# GoldenGate extract lag, seconds
GG_LAG_WARN=60
GG_LAG_CRIT=300

# GoldenGate checkpoint age, minutes
GG_CKPT_WARN_MIN=5
GG_CKPT_CRIT_MIN=15

# sftp_output or server_checklist older than this many minutes = CRIT.
# Set to about twice how often the job that writes them runs.
STALE_MIN=60

# sftp.log size in MB above which = WARN
SFTP_LOG_WARN_MB=1024
