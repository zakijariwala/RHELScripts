#!/bin/bash
# Stub ps. Prints the process list of node STUB_NODE (default 1) from
# $STUB_FIXTURES/ps.nodeN (one command line per process), in the form
# the scripts ask for: args=, comm=, or pid=,args=.
f="$STUB_FIXTURES/ps.node${STUB_NODE:-1}"
case "$*" in
    *pid=*) awk '{ print 4000 + NR, $0 }' "$f" ;;
    *comm=*) awk '{ n = split($1, p, "/"); print p[n] }' "$f" ;;
    *) cat "$f" ;;
esac
