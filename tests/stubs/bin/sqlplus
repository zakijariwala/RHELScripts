#!/bin/bash
# Stub sqlplus. Reads the SQL on stdin and prints the fixture file that
# matches it, from $STUB_FIXTURES. STUB_SQL_CAPTURE=FILE appends the SQL.
sql=$(cat)
[ -n "$STUB_SQL_CAPTURE" ] && printf '%s\n' "$sql" >> "$STUB_SQL_CAPTURE"
pick() {
    case "$sql" in
        *"'ALERT|'"*)                 echo "alert.node${STUB_NODE:-1}" ;;
        *"TEST|login, APP_USER"*)     echo test-db.out ;;
        *"TEST|sqlplus login"*)       echo test-login.out ;;
        *"TEST|standby destination"*) echo test-dest.out ;;
        *"standby destination"*)      echo dest.out ;;
        *"DB SYNC STATUS|Thread"*)    echo sync.out ;;
        *"FRA USAGE"*)                echo fra.out ;;
        *"RMAN BACKUP"*)              echo rman.out ;;
        *"TEMP USAGE"*)               echo temp.out ;;
        *"TABLESPACE USAGE"*)         echo space.out ;;
        *"SESSION COUNT"*)            echo sessions.out ;;
        *"SESSION LIMIT"*)            echo load.out ;;
        *"DB STATUS"*)                echo status.out ;;
    esac
}
f="$STUB_FIXTURES/$(pick)"
[ -r "$f" ] && cat "$f"
exit "$(cat "$STUB_FIXTURES/sqlplus.rc" 2>/dev/null || echo 0)"
