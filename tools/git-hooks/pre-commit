#!/bin/bash
#==============================================================================
# pre-commit  -  block a commit that would leak identifiers, secrets, or
#                write SQL into a monitoring script
#
# Git runs this before every "git commit" once you install it:
#   tools/install-hooks.sh
#
# It checks the STAGED version of each file (what "git add" put in the
# commit), not the copy in your working folder. Three checks:
#   1. tools/check-sanitized.sh   IPs, emails, ports, host names, banned terms
#   2. tools/check-readonly-sql.sh  staged scripts under scripts/ (not actions/)
#   3. gitleaks                   passwords, keys, tokens
#
# Any failure stops the commit. Fix the file, "git add" it, commit again.
#
# OVERRIDES (each prints a WARN line; CI still runs the full check)
#   ALLOW_MISSING_TERMS=1 git commit ...   no tools/banned-terms.txt yet
#   ALLOW_NO_GITLEAKS=1   git commit ...   gitleaks not installed yet
#
# Do not use "git commit --no-verify". It skips this hook completely.
#==============================================================================
set -o pipefail

ROOT="$(git rev-parse --show-toplevel)" || exit 1
cd "$ROOT" || exit 1

STAGED=$(mktemp -d) || exit 1
trap 'rm -rf "$STAGED"' EXIT

# Staged files that still exist after the commit (Added, Copied, Modified, Renamed)
FILES=()
while IFS= read -r -d '' f; do FILES+=("$f"); done < <(
    git diff --cached --name-only -z --diff-filter=ACMR)

if [ "${#FILES[@]}" -eq 0 ]; then exit 0; fi

# Copy the staged content of those files into a temp folder.
printf '%s\0' "${FILES[@]}" | git checkout-index -z --stdin --prefix="$STAGED/" || exit 1

fail=0
# Show paths relative to the repo, not the temp folder.
strip() { sed "s|$STAGED/||g"; }

#------------------------------ 1. sanitize -----------------------------------
echo "pre-commit: check-sanitized (${#FILES[@]} staged files)"
san_opts=()
[ "${ALLOW_MISSING_TERMS:-0}" = 1 ] && san_opts+=(--allow-missing-terms)
BANNED_TERMS_FILE="${BANNED_TERMS_FILE:-$ROOT/tools/banned-terms.txt}" \
    tools/check-sanitized.sh "${san_opts[@]}" "$STAGED" | strip || fail=1

#------------------------------ 2. read-only SQL ------------------------------
SQL_FILES=()
for f in "${FILES[@]}"; do
    case "$f" in
        scripts/actions/*) ;;
        scripts/*.sh|scripts/*.sql) SQL_FILES+=("$STAGED/$f") ;;
    esac
done
if [ "${#SQL_FILES[@]}" -gt 0 ]; then
    echo "pre-commit: check-readonly-sql (${#SQL_FILES[@]} staged scripts)"
    tools/check-readonly-sql.sh "${SQL_FILES[@]}" | strip || fail=1
fi

#------------------------------ 3. gitleaks -----------------------------------
echo "pre-commit: gitleaks"
if command -v gitleaks >/dev/null; then
    # gitleaks 8.19+ uses "git --staged"; older 8.x uses "protect --staged".
    if gitleaks git --help >/dev/null 2>&1; then
        gitleaks git --staged --redact --verbose --no-banner || fail=1
    else
        gitleaks protect --staged --redact --verbose --no-banner || fail=1
    fi
elif [ "${ALLOW_NO_GITLEAKS:-0}" = 1 ]; then
    echo "WARN gitleaks not installed; secret scan skipped (ALLOW_NO_GITLEAKS=1)"
else
    echo "FAIL gitleaks not installed. See docs/pre-commit-hook.md, step 2."
    echo "     To commit without it this once: ALLOW_NO_GITLEAKS=1 git commit ..."
    fail=1
fi

if [ "$fail" -ne 0 ]; then
    echo "pre-commit: BLOCKED. Fix the lines above, git add, and commit again."
    exit 1
fi
echo "pre-commit: OK"
exit 0
